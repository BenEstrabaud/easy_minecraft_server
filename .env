# Minecraft Server Configuration
# Override docker-compose.yml values here

# Change these passwords!
RCON_PASSWORD=changeme

# RCON Web Admin login (separate from RCON_PASSWORD)
RWA_USERNAME=admin
RWA_PASSWORD=changeme

# Server settings
VERSION=LATEST
MEMORY=2560M
MAX_PLAYERS=5
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6
MOTD=Minecraft Server
DIFFICULTY=normal
SEED=

# World border diameter
WORLD_BORDER=5000
NETHER_BORDER=625

# Whitelist - comma-separated Minecraft usernames
ENABLE_WHITELIST=true
WHITELIST=Player1,Player2
